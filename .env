# Base URL of the Metroflow backend API.
# Must include the /api prefix. In dev this targets the real backend directly;
# remove it to fall back to the Vite dev proxy (/api -> http://localhost:8082).
VITE_API_BASE_URL=http://localhost:3001/api
# Origin of the backend for the socket.io connection.
# Leave empty to derive it from VITE_API_BASE_URL (recommended).
VITE_SOCKET_URL=
# Public site URL (marketing site)
VITE_SITE_URL=https://metroflow-site.netlify.app
# --- Google Sign-In (SSO) ---
# Google Identity Services OAuth 2.0 Web Client ID (must match the backend's
# GOOGLE_CLIENT_ID). This value is PUBLIC by design - it is embedded in every
# frontend bundle. The client SECRET must never be placed here.
VITE_GOOGLE_CLIENT_ID=438902996656-dbmnffpr8vufvso2o10esspalvl9c25c.apps.googleusercontent.com
