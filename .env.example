DATABASE_URL="postgresql://user:password@host:port/database"
JWT_SECRET="your-super-secret-jwt-key"

CLIENT_URL="http://localhost:8081"

# --- Frontend (Vite) environment variables ---
# Base URL of the Metroflow backend API (must include the /api prefix).
# VITE_API_BASE_URL=http://localhost:3000/api
# Origin of the backend for the socket.io connection (optional - derived from
# VITE_API_BASE_URL when omitted).
# VITE_SOCKET_URL=
# Public marketing site URL
# VITE_SITE_URL=https://metroflow-site.netlify.app

# --- Google Sign-In (SSO) ---
# Google Identity Services OAuth 2.0 Web Client ID (must match the backend's
# GOOGLE_CLIENT_ID). When unset, the "Continue with Google" button is hidden.
# VITE_GOOGLE_CLIENT_ID=
